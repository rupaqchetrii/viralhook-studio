# ML Datasets and Model Binaries
# Ignore large raw/processed datasets but keep directory structure
ml/data/raw/*
!ml/data/raw/.gitkeep
ml/data/processed/*
!ml/data/processed/.gitkeep

# Ignore heavy trained model files (>50MB) unless explicitly tracked via DVC or Git LFS
backend/models/*.joblib
!backend/models/.gitkeep
backend/models/*.pkl

# Databases
*.sqlite
*.sqlite3
*.db

